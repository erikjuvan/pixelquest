#!/usr/bin/env python3
"""Send one command to the local console daemon."""

import socket
import sys
from pixelquest_runtime import SOCKET_FILE
RESPONSE_TIMEOUT = 15

HELP_TEXT = """Usage: pixelquest <command> [args...]

Commands:
  boot [cartridge-id]   Boot the console, optionally selecting a cartridge
  insert <cartridge-id> Insert a cartridge (development simulation)
  remove                Remove the cartridge and stop the running game
  reset                 Restart the game using the currently inserted cartridge
  status                Show the console and running-game status
  list                  List available cartridges
  monochrome [status|on|off]
                        Show or set the display mode for the next game launch
  quit                  Stop the Pixel Quest daemon

Examples:
  pixelquest list
  pixelquest insert my-game
  pixelquest reset
  pixelquest status
  pixelquest monochrome off
  pixelquest monochrome on

Use `pixelquest --help` to show this message.
"""


def send_command(command):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(RESPONSE_TIMEOUT)
        connection.connect(str(SOCKET_FILE))
        connection.sendall((command + "\n").encode("utf-8"))
        connection.shutdown(socket.SHUT_WR)

        # Responses can contain several lines and exceed one recv buffer.
        chunks = []
        while chunk := connection.recv(4096):
            chunks.append(chunk)

    return b"".join(chunks).decode("utf-8").strip()


def main():
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help", "help"}:
        print(HELP_TEXT, end="")
        return 0

    try:
        response = send_command(" ".join(sys.argv[1:]))
    except (OSError, UnicodeError) as error:
        print(f"Cannot contact Pixel Quest daemon: {error}", file=sys.stderr)
        return 1

    print(response)
    return 0


if __name__ == "__main__":
    sys.exit(main())
